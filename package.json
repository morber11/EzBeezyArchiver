        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "webextension-polyfill": "^0.12.0"
    }
}