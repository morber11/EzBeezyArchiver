{
    "name": "ezbeezyarchiver",
    "version": "3.0.1",
    "description": "EzBeezyArchiver for Firefox. Archives pages using archive services",
    "main": "src/index.js",
    "scripts": {
        "build": "node build.mjs",
        "build:prod": "node build.mjs prod",
