{
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noEmit": true,
        "esModuleInterop": true,
        "target": "ES2025",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": [
            "ES2025",
            "DOM"
        ],
        "types": [
            "chrome"
        ]
    },
    "include": [
        "src/**/*.ts"
    ]
}